# .env.example — Vite development env template.
#
# Copy this file to `.env` / `.env.local` (which IS gitignored) and fill
# the values locally. NEVER commit `.env` — it may contain secrets.
#
# All values are intentionally empty here. They are documented so a new
# contributor knows which env vars the app reads.

# Base URL of the ARS backend API.
# Example: VITE_API_BASE_URL=https://arsplatform.onrender.com
VITE_API_BASE_URL=

# Firebase config — required for PDF uploads to Firebase Cloud Storage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Identity Services (GIS) client ID — required for Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# ── Development-only flags ────────────────────────────────────────────────
#
# These flags exist to unblock legitimate development / QA scenarios.
# See `docs/PRODUCTION_REENABLEMENT_REGISTER.md` for the full register.

# VITE_REQUIRE_REVIEWER_ORCID
# Controls whether the FE blocks Reviewer-role registration / role-upgrade
# requests until a verified ORCID connection is in place.
#
#   true  / 1 / yes / on  → ORCID required (production)
#   false / 0 / no  / off → ORCID optional (development — current default)
#   (missing or unrecognised) → development default (ORCID optional)
#
# The current default is `false` so that dummy Reviewer test accounts can
# be created during local development without a real ORCID. The existing
# ORCID connection UI is still available for users who want to connect.
#
# When you are ready to ship production, flip the fallback in
# `src/config/featureFlags.ts` (`resolveReviewerOrcidRequired`) to `true`
# AND/OR set this env var to `true` for the deployed environment. The FE
# will then require ORCID and surface a clear "Reviewer access requires
# ORCID connection" message. See PROD-002 in
# `docs/PRODUCTION_REENABLEMENT_REGISTER.md` for the re-enable procedure.
VITE_REQUIRE_REVIEWER_ORCID=false

# VITE_REQUIRE_REGISTRATION_OTP
# Controls whether the FE requires OTP verification before completing
# registration, or allows the "Skip for development" bypass.
#
#   true  / 1 / yes / on  → OTP required (production)
#   false / 0 / no  / off → OTP optional (development — current default)
#   (missing or unrecognised) → development default (OTP optional)
#
# The current default is `false` so that dummy accounts can be created
# during local development without going through the email service. The
# "Skip for development" button appears on the email verification page
# when this flag is `false`.
#
# When you are ready to ship production, flip the fallback in
# `src/config/featureFlags.ts` (`requireRegistrationOtp`) to `true`
# AND/OR set this env var to `true` for the deployed environment. The FE
# will then require a valid OTP code and hide the skip button. See PROD-003
# in `docs/PRODUCTION_REENABLEMENT_REGISTER.md` for the re-enable procedure.
VITE_REQUIRE_REGISTRATION_OTP=false
