{
  "name": "ars-platform-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/tests/e2e/researcherUpload.e2e.test.ts",
    "test:e2e:view": "vitest run src/tests/e2e/pdfRender.e2e.test.ts",
    "e2e:production": "playwright test src/tests/e2e/researcherProduction.spec.ts --reporter=list",
    "e2e:production:ui": "playwright test src/tests/e2e/researcherProduction.spec.ts --ui",
    "e2e:production:list": "playwright test src/tests/e2e/researcherProduction.spec.ts --list",
    "e2e:researcher-reviewer": "playwright test --config=playwright.reviewer-flow.config.ts",
    "e2e:researcher-reviewer:list": "playwright test --config=playwright.reviewer-flow.config.ts --list",
    "e2e:researcher-reviewer:ui": "playwright test --config=playwright.reviewer-flow.config.ts --ui",
    "e2e:reviewer-withdrawal": "playwright test --config=playwright.withdrawal-flow.config.ts",
    "e2e:reviewer-withdrawal:list": "playwright test --config=playwright.withdrawal-flow.config.ts --list",
    "e2e:reviewer-withdrawal:ui": "playwright test --config=playwright.withdrawal-flow.config.ts --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "axios": "^1.7.9",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "yup": "^1.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
