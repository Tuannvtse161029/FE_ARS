{
  "name": "ars-platform-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config playwright.e2e.config.ts --ui",
    "test:e2e:list": "playwright test --config playwright.e2e.config.ts --list",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "test:full": "node scripts/run-all-tests.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "e2e:production": "playwright test --config playwright.config.ts",
    "e2e:researcher-reviewer": "playwright test --config playwright.reviewer-flow.config.ts",
    "e2e:reviewer-withdrawal": "playwright test --config playwright.withdrawal-flow.config.ts",
    "e2e:google-onboarding": "playwright test --config playwright.google-onboarding.config.ts",
    "e2e:google-onboarding:headed": "playwright test --config playwright.google-onboarding.headed.config.ts",
    "e2e:roles": "playwright test --config tests/automation/Playwright/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "axios": "^1.7.9",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "yup": "^1.6.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
