{
  "name": "ars-platform-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:raw": "vite",
    "build": "tsc -b && node --max-old-space-size=2048 node_modules/vite/bin/vite.js build",
    "preview": "node --max-old-space-size=512 node_modules/vite/bin/vite.js preview",
    "lint": "eslint .",
    "node:check": "node scripts/check-node.mjs",
    "node:clean": "node scripts/kill-stale-node.mjs",
    "node:clean:apply": "node scripts/kill-stale-node.mjs --yes",
    "test": "node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node --max-old-space-size=2048 node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test --config playwright.e2e.config.ts --ui",
    "test:e2e:list": "playwright test --config playwright.e2e.config.ts --list",
    "test:smoke": "node scripts/run-smoke.mjs",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "test:full": "node scripts/run-all-tests.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "e2e:production": "playwright test --config playwright.config.ts",
    "e2e:researcher-reviewer": "playwright test --config playwright.reviewer-flow.config.ts",
    "e2e:reviewer-withdrawal": "playwright test --config playwright.withdrawal-flow.config.ts",
    "e2e:google-onboarding": "playwright test --config playwright.google-onboarding.config.ts",
    "e2e:google-onboarding:headed": "playwright test --config playwright.google-onboarding.headed.config.ts",
    "e2e:roles": "playwright test --config tests/automation/Playwright/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "axios": "^1.20.0",
    "firebase": "^12.18.0",
    "lucide-react": "^1.39.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
