# .env.playwright.example — Playwright role-function automation env template.
#
# Copy this file to `.env.playwright.local` (which IS gitignored) and fill
# the values locally. NEVER commit `.env.playwright.local` — it contains
# real test account credentials.
#
# All values are intentionally empty here. They are documented so a new
# contributor knows which env vars the test suite reads.

# Base URL of the ARS deployment under test. MUST be set.
# Set this to your local dev server (http://localhost:5173 for Vite dev)
# or an approved staging/preview URL. The runner REFUSES to start without it
# so you can never accidentally hit production.
# Example: E2E_BASE_URL=http://localhost:5173
E2E_BASE_URL=

# Researcher / Lecturer / Reviewer / Graduate Student / Admin role accounts.
# Each pair is consumed by fixtures/role-auth.fixture.ts.
PW_ADMIN_EMAIL=
PW_ADMIN_PASSWORD=

PW_RESEARCHER_EMAIL=
PW_RESEARCHER_PASSWORD=

PW_LECTURER_EMAIL=
PW_LECTURER_PASSWORD=

PW_GRADSTUDENT_EMAIL=
PW_GRADSTUDENT_PASSWORD=

PW_REVIEWER_EMAIL=
PW_REVIEWER_PASSWORD=

# Optional. Marks created records with a unique prefix so test data can be
# cleaned up by name. Default = "ARS-E2E-<short ISO timestamp>".
PW_TEST_RUN_PREFIX=